{
  "name": "dsh-composer-expand",
  "version": "1.0.0",
  "description": "Adds a button beside the composer Send action that enlarges the input box and turns Enter into a newline until toggled back.",
  "type": "module",
  "license": "MIT",
  "author": "Iamwangli (https://github.com/Iamwangli)",
  "homepage": "https://github.com/Iamwangli/dsh-composer-expand#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iamwangli/dsh-composer-expand.git"
  },
  "bugs": {
    "url": "https://github.com/Iamwangli/dsh-composer-expand/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "composer",
    "input",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "dsh-composer-collapsed.png",
    "dsh-composer-expanded.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
